<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/child_switch_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvChildSwitchNumber"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/child_switch_icon_background"
        android:gravity="center"
        android:text="1"
        android:textColor="#6FE4F2"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChildSwitchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Light"
            android:textColor="#F1F4FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChildSwitchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="OFF"
            android:textColor="#9CA9BC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChildSwitchPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0 W"
            android:textColor="#78869A"
            android:textSize="11sp" />

    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchChild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false" />

</LinearLayout>