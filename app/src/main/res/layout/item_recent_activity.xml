<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/recent_activity_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvRecentActivityIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/recent_activity_icon_background"
        android:gravity="center"
        android:text="L"
        android:textColor="#6FE4F2"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentActivityDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kitchen Light"
            android:textColor="#F1F4FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecentActivityAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Turned ON"
            android:textColor="#70E5A4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecentActivityRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kitchen"
            android:textColor="#8996AA"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvRecentActivityTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="10:15 PM"
        android:textColor="#A5B1C4"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>