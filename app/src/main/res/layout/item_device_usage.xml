<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/report_usage_item_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUsageIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/report_usage_icon_background"
            android:gravity="center"
            android:text="L"
            android:textColor="#6FE4F2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUsageDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kitchen Light"
                android:textColor="#F1F4FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsageRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kitchen"
                android:textColor="#8F9CB0"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvUsageStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/report_usage_status_background"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="ACTIVE"
            android:textColor="#70E5A4"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:background="#2B3B54" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUsageLabelOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ON TIME"
                android:textColor="#77859A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvUsageValueOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="4 hours"
                android:textColor="#DCE3EF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUsageLabelTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENERGY"
                android:textColor="#77859A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvUsageValueTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0.08 kWh"
                android:textColor="#6FE4F2"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>