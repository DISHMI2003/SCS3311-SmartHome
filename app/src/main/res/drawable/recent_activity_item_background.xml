<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1E304A" />

            <stroke
                android:width="1dp"
                android:color="#55718F" />

            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape>

            <gradient
                android:angle="270"
                android:startColor="#18263F"
                android:endColor="#111C31" />

            <stroke
                android:width="1dp"
                android:color="#3D5069" />

            <corners android:radius="20dp" />

        </shape>
    </item>

</selector>