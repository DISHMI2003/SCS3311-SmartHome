<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#20334E" />

            <stroke
                android:width="1dp"
                android:color="#55718F" />

            <corners android:radius="17dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#131F34" />

            <stroke
                android:width="1dp"
                android:color="#344862" />

            <corners android:radius="17dp" />
        </shape>
    </item>

</selector>